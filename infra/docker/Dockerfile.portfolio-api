# Portfolio API — Lambda Web Adapter (response streaming for SSE)
FROM public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 AS adapter
FROM public.ecr.aws/docker/library/python:3.12-slim

COPY --from=adapter /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /var/task
COPY services/api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt boto3 mangum \
    && pip install --no-cache-dir --upgrade pip

COPY services/api/app ./app
COPY content ./content
COPY projects/03-research-digest/signal_desk ./projects/03-research-digest/signal_desk
COPY projects/03-research-digest/topics.yaml ./projects/03-research-digest/topics.yaml
COPY projects/03-research-digest/data ./projects/03-research-digest/data
COPY infra/docker/entrypoint.py ./entrypoint.py

ENV PYTHONPATH=/var/task:/var/task/projects/03-research-digest
ENV PORT=8000
ENV AWS_LWA_PORT=8000
ENV AWS_LWA_INVOKE_MODE=response_stream
ENV AWS_LWA_READINESS_CHECK_PATH=/health

EXPOSE 8000
CMD ["python", "entrypoint.py", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
