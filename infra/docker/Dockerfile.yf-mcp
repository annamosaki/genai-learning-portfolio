# Yahoo Finance MCP (yfmcp) — Lambda Web Adapter
FROM public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 AS adapter
FROM public.ecr.aws/docker/library/python:3.12-slim

COPY --from=adapter /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /var/task
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir yfmcp yfinance mcp uvicorn starlette boto3

COPY scripts/run_yfmcp.py ./run_yfmcp.py
COPY infra/docker/entrypoint.py ./entrypoint.py

ENV PORT=8211
ENV AWS_LWA_PORT=8211
ENV YFMCP_PORT=8211
ENV YFMCP_HOST=0.0.0.0
ENV AWS_LWA_INVOKE_MODE=response_stream
ENV AWS_LWA_READINESS_CHECK_PATH=/health
ENV AWS_LWA_READINESS_CHECK_TIMEOUT=20000

EXPOSE 8211
CMD ["python", "entrypoint.py", "python", "run_yfmcp.py"]
