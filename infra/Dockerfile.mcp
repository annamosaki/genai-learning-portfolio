FROM python:3.12-slim

# Install edgartools with AI features
RUN pip install --no-cache-dir "edgartools[ai]"

# Set default identity for Edgar MCP server
ENV EDGAR_IDENTITY="Anna Mosaki mosakianna@gmail.com"

# Expose the MCP server port
EXPOSE 8210

# Start the MCP server
ENTRYPOINT ["edgartools-mcp", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8210"]