# OpenAI Configuration (required for live analysis)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Edgar Tools Configuration
EDGAR_IDENTITY="Agent Desk Demo (your-email@example.com)"
EDGAR_MCP_URL=http://127.0.0.1:8210/mcp
YFMCP_URL=http://127.0.0.1:8211

# Server Configuration
API_PORT=8200
WEB_PORT=3200
HOST=0.0.0.0
DEBUG=false

# HITL approval gates (live defaults)
APPROVAL_TIMEOUT_SECONDS=600
AUTO_APPROVE_ON_TIMEOUT=false
ENABLE_REPLAY=true
MAX_TOOL_ROUNDS=6

# A2A Configuration (set to true to enable separate A2A servers)
ENABLE_A2A_SERVERS=false
AGENT_BASE_PORT=8201

# Web Configuration
ZONE_BASE_PATH=""
AGENT_DESK_API_URL="http://localhost:8200"
