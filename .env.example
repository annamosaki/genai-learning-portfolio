# LLM providers (server-side only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Infra
DATABASE_URL=postgresql://localhost:5432/anna_portfolio
REDIS_URL=redis://localhost:6379
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Observability (Langfuse — https://langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT=anna-portfolio

# Rate limits / spend caps
DAILY_DEMO_LIMIT_PER_IP=20
MONTHLY_SPEND_CAP_USD=50

# Multi-zone configuration
LLM_LAB_URL=http://localhost:3100
AGENT_DESK_URL=http://localhost:3200
RESEARCH_DIGEST_URL=http://localhost:3300
ZONE_BASE_PATH_LAB=/demos/llm-lab
ZONE_BASE_PATH_DESK=/demos/agent-desk
ZONE_BASE_PATH_DIGEST=/demos/research-digest

# Research Digest — optional free-tier market news (skipped when empty)
FINNHUB_API_KEY=

# Production secrets live in AWS Secrets Manager:
#   anna-portfolio/app-secrets   (JSON: FINNHUB_API_KEY, OPENAI_API_KEY, …)
#   anna-portfolio/openai-api-key
# Newsletter delivery uses Amazon SES from digest@annamosaki.com

# Edgar MCP Server
EDGAR_IDENTITY=Anna Mosaki mosakianna@gmail.com

# Optional
GITHUB_TOKEN=
PLAUSIBLE_DOMAIN=
